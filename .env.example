# ================================================================
# venysound.com 프로덕션 환경변수 설정
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요
# cp .env.example .env
# ================================================================

# Node 환경 (배포 시 반드시 production)
# 로컬에서 npm run dev 는 스크립트가 NODE_ENV=development 로 띄웁니다.
# .env 에 NODE_ENV=production 이 있으면 예전에는 db.ts 가 이를 덮어써 로그에 production 이 찍히기도 했음(현재는 덮어쓰지 않음).
# 그래도 로컬 혼동을 줄이려면 개발용 .env 에서 아래 줄을 주석 처리하거나 development 로 두는 것을 권장합니다.
NODE_ENV=production

# 서버 포트
PORT=5000

# 사이트 주소 (네이버/카카오 등 OAuth 콜백·리디렉트에 사용)
# 실제로 사용자가 쓰는 호스트와 반드시 일치 (www 쓰면 https://www.… 로 설정)
# 로컬 개발: http://localhost:5000
SITE_URL=https://venysound.com
# 프로덕션에서 위 호스트와 www/apex만 다른 요청(예: www.venysound.com)은 301으로 위 주소로 통일됩니다.

# (선택) 리버스 프록시 신뢰 — Express trust proxy. 기본 1.
# Cloudflare+Nginx 등 다단일 때 req.ip·세션에 영향. 방문 국가는 CF-Connecting-IP 우선으로 잡습니다.
# TRUST_PROXY=2
# 또는 TRUST_PROXY=true (신뢰할 프록시가 많을 때만, 직접 노출 금지)

# ----------------------------------------------------------------
# (선택) 로그인·회원가입·관리자 페이지 주소 (SPA 경로만 변경, /api/… 는 그대로)
# 운영에서 바꿀 경우 서버 .env 와 클라이언트 빌드에 반드시 같은 값을 넣어야 합니다.
#   서버 런타임: LOGIN_PAGE_PATH, REGISTER_PAGE_PATH, ADMIN_PAGE_PATH
#   Vite 빌드 시: VITE_LOGIN_PAGE_PATH, VITE_REGISTER_PAGE_PATH, VITE_ADMIN_PAGE_PATH
# 비우면 기본 /login, /register, /admin (변경 전과 동일). 짧은 단어 대신 긴 랜덤 경로 권장.
# 예:
#   LOGIN_PAGE_PATH=/acnt-k9m2xq7wL4n
#   VITE_LOGIN_PAGE_PATH=/acnt-k9m2xq7wL4n
# ----------------------------------------------------------------
# LOGIN_PAGE_PATH=
# REGISTER_PAGE_PATH=
# ADMIN_PAGE_PATH=
# VITE_LOGIN_PAGE_PATH=
# VITE_REGISTER_PAGE_PATH=
# VITE_ADMIN_PAGE_PATH=

# ----------------------------------------------------------------
# (선택) 페이업 다날 결제창 POST — Vite 빌드 시에만 주입 (서버 .env만 바꿔서는 적용 안 됨)
# 규격서 3.2: STARTURL 히든은 기본 포함. 중복·파싱 이슈 시만 VITE_PAYUP_DANAL_FORM_OMIT_STARTURL=true
# 인앱 웹뷰·iframe에서만 이상하면 → VITE_PAYUP_DANAL_FORM_TARGET=_top
# ----------------------------------------------------------------
# VITE_PAYUP_DANAL_FORM_OMIT_STARTURL=false
# VITE_PAYUP_DANAL_FORM_TARGET=_self

# ----------------------------------------------------------------
# PostgreSQL 데이터베이스
# 형식: postgresql://사용자:비밀번호@호스트:포트/DB명
# VPS 로컬 설치 시 예시:
# ----------------------------------------------------------------
DATABASE_URL=postgresql://venysound:비밀번호를_여기에_입력@localhost:5432/venysound

# 배포 후 코드에 users.notify_activity_email 이 있으면 DB에 컬럼이 없을 때
# 로그인·라디오·프로필 등이 500 될 수 있음 → script/migrations/008-notify-activity-email.sql 실행

# ----------------------------------------------------------------
# 세션 시크릿 (최소 32자 이상의 랜덤 문자열)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------
SESSION_SECRET=여기에_32자_이상의_랜덤_문자열_입력

# (선택) 프로덕션만 적용됨. www + apex 동시 서비스 시 로그인 쿠키 공유. 앞에 점 포함.
# 예: SESSION_COOKIE_DOMAIN=.venysound.com  — 로컬(npm run dev)에서는 코드가 domain 을 무시함.
#SESSION_COOKIE_DOMAIN=
# (선택) NODE_ENV=production 인데 http 로 테스트할 때만: 세션 쿠키에 Secure 안 붙임
#SESSION_COOKIE_INSECURE=1

# ----------------------------------------------------------------
# Google OAuth (https://console.cloud.google.com)
# 승인된 리디렉션 URI: https://venysound.com/api/auth/google/callback
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------
# Naver OAuth (https://developers.naver.com)
# 콜백 URL: https://venysound.com/api/auth/naver/callback
# ----------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----------------------------------------------------------------
# Kakao OAuth (https://developers.kakao.com)
# 리디렉션 URI: https://venysound.com/api/auth/kakao/callback
# ----------------------------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ----------------------------------------------------------------
# Facebook OAuth (https://developers.facebook.com)
# 유효한 OAuth 리디렉션 URI: https://venysound.com/api/auth/facebook/callback
# 로컬: http://localhost:5000/api/auth/facebook/callback
# ----------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----------------------------------------------------------------
# TikTok Login Kit (https://developers.tiktok.com) — Login Kit 제품 활성화 필요
# Redirect URI를 포털 Login Kit에 코드가 보내는 문자열과 한 글자도 다르게 등록하지 말 것
# (https 필수, 끝 슬래시 유무·www 유무까지 동일): {SITE_URL}/api/auth/tiktok/callback
# 예: https://venysound.com/api/auth/tiktok/callback
#
# TikTok 웹 Login Kit: 포털은 http://localhost·127.0.0.1 Redirect URI 를 거절함(https 공개 URL만).
# 로컬 테스트: ngrok·Cloudflare Tunnel 등으로 https://xxxx.ngrok-free.app → :5000 터널 후
#   포털에 https://xxxx.ngrok-free.app/api/auth/tiktok/callback 등록,
#   SITE_URL 과 TIKTOK_REDIRECT_URI 를 동일한 https 베이스로 맞추고 브라우저도 그 URL 로만 접속.
# (다른 OAuth 는 localhost 허용될 수 있으나 TikTok 웹 설정은 위 제약이 있음.)
# 운영/스테이징·터널 고정: TIKTOK_REDIRECT_URI=https://your.domain/api/auth/tiktok/callback
# TIKTOK_REDIRECT_URI=
# 키는 앱의 Client key / Client secret (공백·따옴표 없이)
#
# Sandbox 앱(포털에 "Sandbox version" 으로 보이는 앱): 프로덕션 키와 다릅니다.
#   이 경우 .env 에 Sandbox 앱의 키를 넣고, SITE_URL 은 데모 영상에 나오는 URL과 동일하게
#   (예: 스테이징 도메인이면 https://staging.venysound.com) 맞춘 뒤, 같은 Redirect URI 를
#   해당 TikTok 앱(Sandbox) 설정에 등록하세요. OAuth 엔드포인트 URL 은 코드에서 바꿀 필요 없음.
# ----------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ----------------------------------------------------------------
# 관리자(개발자) 계정 - 이 계정으로 로그인 시 관리자 페이지 접근 가능
# ADMIN_EMAIL=개발자이메일@example.com (쉼표로 여러 개 가능)
# 또는 ADMIN_USER_ID=google_123456789 (로그인 시 사용되는 사용자 id)
# ----------------------------------------------------------------
# ADMIN_EMAIL=your@email.com
# ADMIN_USER_ID=

# ----------------------------------------------------------------
# 프리미엄 구독 계좌이체 (무통장 입금) 안내용
# /pricing 에서 "계좌이체로 구독하기" 시 이 계좌 정보가 노출됩니다.
# ----------------------------------------------------------------
BANK_NAME=농협은행
BANK_ACCOUNT=317-0025-6758-41
BANK_HOLDER=주식회사에드가씨에스티

# ----------------------------------------------------------------
# AI 음악 생성 (둘 중 하나만 설정해도 됨. SUNOAPI 있으면 우선 사용)
# (1) Suno API - https://sunoapi.org/ 가입 → API Key 발급
#     https://sunoapi.org/ko/api-key 에서 복사 → SUNOAPI_API_KEY=
# (2) AIMusicAPI - https://aimusicapi.ai/ 가입 → Dashboard → API Keys
#     AIMUSICAPI_API_KEY=
# ----------------------------------------------------------------
# SUNOAPI_API_KEY=your_suno_api_key_here
# AIMUSICAPI_API_KEY=your_aimusicapi_key_here

# ----------------------------------------------------------------
# (선택) 이메일 발송 — 환영 메일, 추천 신곡, 댓글·팔로·쪽지·좋아요 알림 등
# 미설정 시 해당 메일은 보내지 않음 (앱 내 알림만).
# PUBLIC_SITE_URL 은 메일 본문 링크용 (없으면 SITE_URL 사용)
# ----------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@yourdomain.com
# PUBLIC_SITE_URL=https://venysound.com

# ----------------------------------------------------------------
# 글로벌 유통 — 배포사 웹훅 (DistroKid 등에서 우리 API로 상태·정산을 넣을 때)
# 미설정 시: POST /api/distribution/webhooks/... 호출 시 500
#   "DISTRIBUTION_WEBHOOK_SECRET is not configured"
# 요청 헤더: x-distribution-webhook-secret: (아래 값과 동일)
# 엔드포인트 예 (SITE_URL 기준):
#   POST {SITE_URL}/api/distribution/webhooks/distrokid/status
#   POST {SITE_URL}/api/distribution/webhooks/distrokid/payouts
# body 형식은 server/routes.ts 의 해당 핸들러 참고
# (수동) 관리자 로그인 후 POST /api/admin/distribution/import-earnings — CSV 일괄 정산 반입
# ----------------------------------------------------------------
# DISTRIBUTION_WEBHOOK_SECRET=긴_랜덤_문자열_예_session_secret_과_동일_방식

# ----------------------------------------------------------------
# Spotify — 음원 목록「우리 곡 해외 출시」(Web API / Client Credentials)
# 대시보드: https://developer.spotify.com/dashboard
# SPOTIFY_INTERNATIONAL_ARTIST_IDS: Spotify 아티스트 ID 또는 전체 URL(쉼표·공백 구분)
# 예: 4iHNK0tOyZPYnO7rJsMNvc 또는 https://open.spotify.com/artist/4iHNK0tOyZPYnO7rJsMNvc
# SPOTIFY_INTERNATIONAL_FROM_USER_IDS: (선택) VenySound 로그인 user id(sub)만 유통 병합. 비우면 전체 회원의 배포완료(delivered/live) 건
# 배포 건에 music.spotify_album_id 또는 external_release_ref 의 UPC(예 distrokid:8256…)가 있으면 해외 탭에 합쳐짐
# SPOTIFY_INTERNATIONAL_MARKETS: 조회할 국가 코드 쉼표 목록 (미설정 시 US,KR,GB,JP 병합)
# SPOTIFY_INTERNATIONAL_INCLUDE_GROUPS: 기본 album,single,appears_on,compilation (Spotify API 기본과 동일)
# SPOTIFY_MARKET: (구방식) 단일 market만 쓸 때. SPOTIFY_INTERNATIONAL_MARKETS 가 있으면 그쪽이 우선
# ----------------------------------------------------------------
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_INTERNATIONAL_ARTIST_IDS=
# SPOTIFY_INTERNATIONAL_FROM_USER_IDS=
# SPOTIFY_INTERNATIONAL_MARKETS=US,KR
# SPOTIFY_MARKET=KR
# (선택) 아티스트당 최대 앨범 수 상한 (기본 200)
# SPOTIFY_INTERNATIONAL_ALBUM_CAP=200

# ----------------------------------------------------------------
# 페이업(Payup) — 다날 인증결제·자동결제·부분취소 (가맹 승인 후 담당자가 merchantId / apiCertKey 전달)
# 서버 IP는 페이업에 사전 등록 필요. 연동 규격: 프로젝트 내 server/payup/*.ts
# 개발: PAYUP_USE_TEST=true (기본) → https://api.testpayup.co.kr
# 운영 전: PAYUP_USE_TEST=false → https://api.payup.co.kr
# ----------------------------------------------------------------
# PAYUP_MERCHANT_ID=
# PAYUP_API_CERT_KEY=
# PAYUP_USE_TEST=true
# 구독 카드: [페이업] 인증결제 DANAL 다이렉트 규격서 v1.1.1 (order→결제창→auth_return→payUrl JSON)
# 기본: 주문 JSON에 merchantId 미포함(URL 경로에만). 본문에도 넣어야 하는 가맹점만 PAYUP_ORDER_INCLUDE_MERCHANT_IN_BODY=true
# USESKIPPAGE·QUOTA: 기본 전송 안 함(전문 파싱 완화). 예전 전문 필요 시 PAYUP_ORDER_STRIP_NONSPEC_FIELDS=false
# PAYUP_ORDER_STRIP_NONSPEC_FIELDS=true
# 모바일(WM) returnUrl: 기본 전송(복귀 안정화). 페이업이 6003 등으로 거절하면 PAYUP_ORDER_WM_RETURN_URL=false
# (선택) 금액 문자열 — 기본 비패딩(페이업 운영 권장). 필요 시만 pad12|pad10. short|plain=비패딩 최대10자리. 레거시 PAYUP_ORDER_AMOUNT_SHORT=true
# PAYUP_ORDER_AMOUNT_STYLE=
# (선택) 주문 서명의 amount 구간 — 규격 예시는 비패딩(기본). 본문 amount와 동일 문자열로 서명해야 하면 body
# PAYUP_ORDER_SIGNATURE_AMOUNT=
# (선택) 주문 JSON 키 — 자료가 대문자 필드면 upper (auth_return 키는 소문자 유지)
# PAYUP_ORDER_JSON_KEYS=
# PAYUP_ORDER_INCLUDE_MERCHANT_IN_BODY=
# PAYUP_ORDER_STRIP_NONSPEC_FIELDS=
# PAYUP_ORDER_WM_RETURN_URL=
# (선택) 주문 POST 본문 — 기본은 JSON. 운영 order URL이 JSON만 받으면 form|urlencoded 시 HTTP 415(Unsupported Media Type).
# PAYUP_ORDER_BODY_FORMAT=json  ← 명시 권장. form 은 일부 환경에서 페이업이 HTTP 415 를 반환(서버는 JSON으로 1회 재시도).
# (선택) 결제창 기본 카드사 코드 4자리 — 부록 다날코드 참고. 미설정 시 0000
# PAYUP_SUBSCRIPTION_CARDCODE=0000
# (테스트·스테이징만) 페이업에서 승인 후 PG 취소·환불했는데 DB만 paid 로 남은 경우, 로그인 사용자가 최신 payup 카드 구독 건을 되돌림.
# POST /api/subscription/payup/self-revert-last-card-payment — 운영에는 두지 말 것. 관리자는 POST /api/admin/payments/:id/revoke-payup-subscription
# PAYUP_ALLOW_USER_SELF_REVERT=true
#
# --- PG 취소·환불 → 서버·음악생성 한도 자동 동기화 ---
# 1) 웹훅(권장): 페이업 관리자·규격서에서 통지 URL을 등록 — https://{SITE}/api/webhooks/payup (POST 또는 GET)
#    본문에 취소·환불·cancelDateTime 등이 포함되고 transactionId(페이업 거래번호)가 오면 paid 구독 건을 refunded 처리.
# PAYUP_WEBHOOK_SECRET=  # 설정 시 Authorization: Bearer … 또는 x-payup-webhook-secret 헤더 필요
# PAYUP_WEBHOOK_DEBUG=true  # 수신 시 action·키 이름 일부만 서버 로그(운영에서는 끔)
#
# 2) 거래 조회 HTTP(규격서의 조회 URL을 확인한 뒤): 예시 플레이스홀더 — 실제 경로·필드는 계약 문서 필수
# PAYUP_TXN_RECONCILE_PATH=/v2/api/payment/{merchantId}/inquiry
# PAYUP_TXN_RECONCILE_SIGN_MODE=cancel2   # 기본 cancel2 = merchantId|transactionId|apiCertKey 서명(부분취소와 동일 조합)
# 카드사만 승인·사이트는 pending 일 때: 위가 있어야 POST /api/subscription/payup/sync-approved-pending 및 관리자 finalize-payup-pending-inquiry 가 PG 조회로 paid 반영 가능
# 로그인 시 요금제·음악생성 진입마다 POST /api/subscription/payup/reconcile-latest 가 위 경로로 최신 paid 건을 조회함(3분 스로틀).

# ----------------------------------------------------------------
# Play Store TWA (Trusted Web Activity)
# assetlinks.json 제공용. TWA 프로젝트 생성 후 Play Console 앱 서명 SHA-256 입력
# 쉼표로 여러 개 입력 가능 (디버그/릴리즈 키 등)
# ----------------------------------------------------------------
# TWA_PACKAGE_NAME=com.venysound.app
# TWA_SHA256_FINGERPRINT=XX:XX:...
