# ================================================================
# venysound.com 프로덕션 환경변수 설정
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요
# cp .env.example .env
# ================================================================

# Node 환경 (배포 시 반드시 production)
NODE_ENV=production

# 서버 포트
PORT=5000

# 사이트 주소 (네이버/카카오 등 OAuth 콜백·리디렉트에 사용)
# 실제로 사용자가 쓰는 호스트와 반드시 일치 (www 쓰면 https://www.… 로 설정)
# 로컬 개발: http://localhost:5000
SITE_URL=https://venysound.com
# 프로덕션에서 위 호스트와 www/apex만 다른 요청(예: www.venysound.com)은 301으로 위 주소로 통일됩니다.

# ----------------------------------------------------------------
# (선택) 로그인·회원가입·관리자 페이지 주소 (SPA 경로만 변경, /api/… 는 그대로)
# 운영에서 바꿀 경우 서버 .env 와 클라이언트 빌드에 반드시 같은 값을 넣어야 합니다.
#   서버 런타임: LOGIN_PAGE_PATH, REGISTER_PAGE_PATH, ADMIN_PAGE_PATH
#   Vite 빌드 시: VITE_LOGIN_PAGE_PATH, VITE_REGISTER_PAGE_PATH, VITE_ADMIN_PAGE_PATH
# 비우면 기본 /login, /register, /admin (변경 전과 동일). 짧은 단어 대신 긴 랜덤 경로 권장.
# 예:
#   LOGIN_PAGE_PATH=/acnt-k9m2xq7wL4n
#   VITE_LOGIN_PAGE_PATH=/acnt-k9m2xq7wL4n
# ----------------------------------------------------------------
# LOGIN_PAGE_PATH=
# REGISTER_PAGE_PATH=
# ADMIN_PAGE_PATH=
# VITE_LOGIN_PAGE_PATH=
# VITE_REGISTER_PAGE_PATH=
# VITE_ADMIN_PAGE_PATH=

# ----------------------------------------------------------------
# PostgreSQL 데이터베이스
# 형식: postgresql://사용자:비밀번호@호스트:포트/DB명
# VPS 로컬 설치 시 예시:
# ----------------------------------------------------------------
DATABASE_URL=postgresql://venysound:비밀번호를_여기에_입력@localhost:5432/venysound

# 배포 후 코드에 users.notify_activity_email 이 있으면 DB에 컬럼이 없을 때
# 로그인·라디오·프로필 등이 500 될 수 있음 → script/migrations/008-notify-activity-email.sql 실행

# ----------------------------------------------------------------
# 세션 시크릿 (최소 32자 이상의 랜덤 문자열)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------
SESSION_SECRET=여기에_32자_이상의_랜덤_문자열_입력

# (선택) www + apex(비-www) 동시 서비스 시 로그인 쿠키 공유. 앞에 점 포함.
# 예: SESSION_COOKIE_DOMAIN=.venysound.com  — 안 쓰면 비우거나 이 줄을 넣지 않음.
#SESSION_COOKIE_DOMAIN=

# ----------------------------------------------------------------
# Google OAuth (https://console.cloud.google.com)
# 승인된 리디렉션 URI: https://venysound.com/api/auth/google/callback
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------
# Naver OAuth (https://developers.naver.com)
# 콜백 URL: https://venysound.com/api/auth/naver/callback
# ----------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----------------------------------------------------------------
# Kakao OAuth (https://developers.kakao.com)
# 리디렉션 URI: https://venysound.com/api/auth/kakao/callback
# ----------------------------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ----------------------------------------------------------------
# Facebook OAuth (https://developers.facebook.com)
# 유효한 OAuth 리디렉션 URI: https://venysound.com/api/auth/facebook/callback
# 로컬: http://localhost:5000/api/auth/facebook/callback
# ----------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----------------------------------------------------------------
# TikTok Login Kit (https://developers.tiktok.com) — Login Kit 제품 활성화 필요
# Redirect URI를 포털에 정확히 등록: {SITE_URL}/api/auth/tiktok/callback
# 예: https://venysound.com/api/auth/tiktok/callback (SITE_URL 과 www 유무 일치)
# 키는 앱의 Client key / Client secret (공백·따옴표 없이)
#
# Sandbox 앱(포털에 "Sandbox version" 으로 보이는 앱): 프로덕션 키와 다릅니다.
#   이 경우 .env 에 Sandbox 앱의 키를 넣고, SITE_URL 은 데모 영상에 나오는 URL과 동일하게
#   (예: 스테이징 도메인이면 https://staging.venysound.com) 맞춘 뒤, 같은 Redirect URI 를
#   해당 TikTok 앱(Sandbox) 설정에 등록하세요. OAuth 엔드포인트 URL 은 코드에서 바꿀 필요 없음.
# ----------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ----------------------------------------------------------------
# 관리자(개발자) 계정 - 이 계정으로 로그인 시 관리자 페이지 접근 가능
# ADMIN_EMAIL=개발자이메일@example.com (쉼표로 여러 개 가능)
# 또는 ADMIN_USER_ID=google_123456789 (로그인 시 사용되는 사용자 id)
# ----------------------------------------------------------------
# ADMIN_EMAIL=your@email.com
# ADMIN_USER_ID=

# ----------------------------------------------------------------
# 프리미엄 구독 계좌이체 (무통장 입금) 안내용
# /pricing 에서 "계좌이체로 구독하기" 시 이 계좌 정보가 노출됩니다.
# ----------------------------------------------------------------
BANK_NAME=농협은행
BANK_ACCOUNT=317-0025-6758-41
BANK_HOLDER=주식회사에드가씨에스티

# ----------------------------------------------------------------
# AI 음악 생성 (둘 중 하나만 설정해도 됨. SUNOAPI 있으면 우선 사용)
# (1) Suno API - https://sunoapi.org/ 가입 → API Key 발급
#     https://sunoapi.org/ko/api-key 에서 복사 → SUNOAPI_API_KEY=
# (2) AIMusicAPI - https://aimusicapi.ai/ 가입 → Dashboard → API Keys
#     AIMUSICAPI_API_KEY=
# ----------------------------------------------------------------
# SUNOAPI_API_KEY=your_suno_api_key_here
# AIMUSICAPI_API_KEY=your_aimusicapi_key_here

# ----------------------------------------------------------------
# (선택) 이메일 발송 — 환영 메일, 추천 신곡, 댓글·팔로·쪽지·좋아요 알림 등
# 미설정 시 해당 메일은 보내지 않음 (앱 내 알림만).
# PUBLIC_SITE_URL 은 메일 본문 링크용 (없으면 SITE_URL 사용)
# ----------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@yourdomain.com
# PUBLIC_SITE_URL=https://venysound.com

# ----------------------------------------------------------------
# 글로벌 유통 — 배포사 웹훅 (DistroKid 등에서 우리 API로 상태·정산을 넣을 때)
# 미설정 시: POST /api/distribution/webhooks/... 호출 시 500
#   "DISTRIBUTION_WEBHOOK_SECRET is not configured"
# 요청 헤더: x-distribution-webhook-secret: (아래 값과 동일)
# 엔드포인트 예 (SITE_URL 기준):
#   POST {SITE_URL}/api/distribution/webhooks/distrokid/status
#   POST {SITE_URL}/api/distribution/webhooks/distrokid/payouts
# body 형식은 server/routes.ts 의 해당 핸들러 참고
# (수동) 관리자 로그인 후 POST /api/admin/distribution/import-earnings — CSV 일괄 정산 반입
# ----------------------------------------------------------------
# DISTRIBUTION_WEBHOOK_SECRET=긴_랜덤_문자열_예_session_secret_과_동일_방식

# ----------------------------------------------------------------
# Play Store TWA (Trusted Web Activity)
# assetlinks.json 제공용. TWA 프로젝트 생성 후 Play Console 앱 서명 SHA-256 입력
# 쉼표로 여러 개 입력 가능 (디버그/릴리즈 키 등)
# ----------------------------------------------------------------
# TWA_PACKAGE_NAME=com.venysound.app
# TWA_SHA256_FINGERPRINT=XX:XX:...
